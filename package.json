{
  "name": "identity-issuer-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "issue-air-credential": "RUNNER=true nest start --entryFile runners/issue-air-credential",
    "batch-issue-vc-csv": "RUNNER=true nest start --entryFile runners/batch-issue-vc-csv",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "repl": "nest start --entryFile repl",
    "repl:dev": "nest start --watch --entryFile repl",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@iden3/js-crypto": "^1.3.2",
    "@iden3/js-jsonld-merklization": "^1.7.2",
    "@iden3/js-jwz": "^1.14.0",
    "@iden3/js-merkletree": "^1.5.2",
    "@mikro-orm/cli": "^7.1.1",
    "@mikro-orm/core": "^7.1.1",
    "@mikro-orm/migrations": "^7.1.1",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.1.1",
    "@mocanetwork/moca-iden3": "^2.0.1",
    "@mocanetwork/identity-js-sdk": "^3.0.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@owf/crypto": "^0.3.1",
    "@owf/token-status-list": "^0.3.2",
    "@sd-jwt/core": "^0.20.0",
    "@sd-jwt/sd-jwt-vc": "^0.20.0",
    "axios": "^1.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv": "^6.6.0",
    "dotenv": "^17.4.2",
    "ffjavascript": "^0.3.1",
    "jose": "^6.2.3",
    "jsonld": "^9.0.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "multiformats": "^14.0.5",
    "reflect-metadata": "^0.2.2",
    "rfc4648": "^1.5.4",
    "rxjs": "^7.8.1",
    "snarkjs": "^0.7.6",
    "socks-proxy-agent": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonld": "^1.5.15",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "mikro-orm": {
    "useTsNode": true,
    "tsConfigPath": "./tsconfig.json",
    "configPaths": [
      "./src/mikro-orm.config.ts"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
